<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080D0F"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HUNTMATE"
            android:textColor="#F4F7F4"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="0.08" />

        <Button
            android:id="@+id/appsButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/huntmate_button_neutral"
            android:text="Outdoor apps"
            android:textAllCaps="false"
            android:textColor="#E7F1EA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <Spinner
            android:id="@+id/activitySpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/huntmate_button_neutral"
            android:contentDescription="Activity"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:popupBackground="#172126" />

        <Spinner
            android:id="@+id/toolSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/huntmate_button_neutral"
            android:contentDescription="Activity tools"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:popupBackground="#172126" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:minHeight="220dp">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/huntmate_button_neutral"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="© OpenStreetMap contributors · ODbL"
            android:textColor="#D9E2E0"
            android:textSize="10sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/huntmate_panel"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR HUNT"
                    android:textColor="#F4F7F4"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Track the day. Know your ground."
                    android:textColor="#A8B4B5"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/huntmate_status_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="GPS ready"
                android:textColor="#8FE0A4"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/huntmate_button_neutral"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Waiting for GPS…"
            android:textColor="#D4DEDE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Distance: 0 m   •   Points: 0"
            android:textColor="#A8B4B5"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/recenterButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/huntmate_button_neutral"
                android:contentDescription="Recenter on my location"
                android:minWidth="0dp"
                android:text="◎  My location"
                android:textAllCaps="false"
                android:textColor="#EAF2F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/mapTypeButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/huntmate_button_neutral"
                android:contentDescription="Toggle map style"
                android:minWidth="0dp"
                android:text="Satellite"
                android:textAllCaps="false"
                android:textColor="#EAF2F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/compassButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/huntmate_button_neutral"
                android:contentDescription="Orient map to compass heading"
                android:minWidth="0dp"
                android:text="⌖  Compass"
                android:textAllCaps="false"
                android:textColor="#EAF2F0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/huntmate_button_primary"
                android:minWidth="0dp"
                android:text="Start tracking"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/huntmate_button_neutral"
                android:minWidth="0dp"
                android:text="Pause"
                android:textAllCaps="false"
                android:textColor="#EAF2F0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/huntmate_button_stop"
                android:minWidth="0dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="#FFD7D4"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>