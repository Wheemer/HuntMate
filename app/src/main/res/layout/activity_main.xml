<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101713">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HUNTMATE"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#E4F0E7"
        android:padding="16dp" />

    <Spinner
        android:id="@+id/activitySpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Activity" />

    <Spinner
        android:id="@+id/toolSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:contentDescription="Activity tools" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appsButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:text="HuntMate Apps · Get Outdoor"
        android:textAllCaps="false"
        android:textColor="#E4F0E7"
        android:backgroundTint="#24352B"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_layers"
        app:iconTint="#8BD5A5"
        app:iconGravity="textStart" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/landRestrictionsButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:text="Land Layers ON"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#347A50"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_layers"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mapLegendButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="60dp"
            android:text="Map Legend / Colors"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#24352B"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_layers"
            app:iconTint="#8BD5A5"
            app:iconGravity="textStart"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/governmentZonesButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:text="Official Zones"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#347A50"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_layers"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <TextView
            android:id="@+id/mapAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#E51A241E"
            android:padding="5dp"
            android:text="© OpenStreetMap contributors · ODbL"
            android:textSize="11sp"
            android:textColor="#DCE8DF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="#171F1A">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="GPS ready"
            android:textColor="#E4F0E7"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:text="Waiting for GPS…"
            android:textColor="#B3C2B7" />

        <TextView
            android:id="@+id/navigationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="6dp"
            android:text="Save a truck, camp or waypoint for return guidance"
            android:textColor="#C5A7F2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="8dp"
            android:text="Distance: 0 m"
            android:textColor="#B3C2B7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recenterButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Recenter on my location"
                android:text=""
                android:backgroundTint="#24352B"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_my_location"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="#8BD5A5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapTypeButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:minWidth="112dp"
                android:text="Map"
                android:textAllCaps="false"
                android:textColor="#E4F0E7"
                android:backgroundTint="#24352B"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_layers"
                app:iconGravity="textStart"
                app:iconSize="22dp"
                app:iconTint="#8BD5A5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compassButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Orient map to compass heading"
                android:text=""
                android:backgroundTint="#24352B"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_compass"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="#8BD5A5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveWaypointButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Save point"
                android:textAllCaps="false"
                android:textColor="#E4F0E7"
                android:backgroundTint="#24352B"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_layers"
                app:iconTint="#8BD5A5"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/returnButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Return to…"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6F4A91"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_compass"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconSize="18dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Start"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#347A50"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_play"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:text="Pause"
                android:textAllCaps="false"
                android:textColor="#E4F0E7"
                android:backgroundTint="#24352B"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_pause"
                app:iconTint="#8BD5A5"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#A93232"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_stop"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
