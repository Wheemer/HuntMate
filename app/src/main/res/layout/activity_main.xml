<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101014" android:fitsSystemWindows="true">
    <org.maplibre.android.maps.MapView android:id="@+id/mapView" android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="top"
        android:gravity="center_vertical" android:background="#ED101014" android:paddingStart="16dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HUNTMATE" android:textColor="#F5F1F8" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Newfoundland &amp; Labrador" android:textColor="#B9B4BE" android:textSize="11sp"/>
        </LinearLayout>
        <Button android:id="@+id/activityButton" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/map_control_dark" android:paddingHorizontal="12dp" android:text="Hunting" android:textAllCaps="false" android:textColor="#F5F1F8"/>
        <Button android:id="@+id/appsButton" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="Records" android:textAllCaps="false" android:textColor="#D7C3FF"/>
    </LinearLayout>

    <LinearLayout android:layout_width="48dp" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="74dp" android:layout_marginEnd="10dp" android:orientation="vertical">
        <ImageButton android:id="@+id/recenterButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/map_control" android:contentDescription="Recenter on my location" android:padding="13dp" android:scaleType="centerInside" android:src="@drawable/ic_map_location" android:tint="#D4D8D2"/>
        <ImageButton android:id="@+id/officialLayersButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/map_control" android:contentDescription="Official Newfoundland and Labrador map layers" android:padding="13dp" android:scaleType="centerInside" android:src="@drawable/ic_map_layers" android:tint="#D4D8D2"/>
        <ImageButton android:id="@+id/mapTypeButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/map_control" android:contentDescription="Change map type" android:padding="13dp" android:scaleType="centerInside" android:src="@drawable/ic_map_style" android:tint="#D4D8D2"/>
        <ImageButton android:id="@+id/toolsButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/map_control" android:contentDescription="Map tools" android:padding="13dp" android:scaleType="centerInside" android:src="@drawable/ic_map_tools" android:tint="#D4D8D2"/>
    </LinearLayout>

    <TextView android:id="@+id/mapAttribution" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="8dp" android:layout_marginBottom="142dp" android:background="#DFFFFFFF" android:padding="4dp" android:text="OpenStreetMap contributors - ODbL" android:textColor="#303030" android:textSize="10sp"/>

    <LinearLayout android:id="@+id/trackingPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#F5101014" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F2EFF5" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/statsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CFC9D3" android:textSize="13sp"/>
            </LinearLayout>
            <Button android:id="@+id/trackingPanelToggle" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Details" android:textAllCaps="false" android:textColor="#D7C3FF"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/trackingDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/locationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D0CBD5" android:textSize="14sp"/>
            <TextView android:id="@+id/navigationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Save a truck, camp or waypoint for return guidance" android:textColor="#D0CBD5" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp">
            <Button android:id="@+id/startButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/action_primary" android:minWidth="0dp" android:text="Start tracking" android:textAllCaps="false" android:textColor="#102016"/>
            <Button android:id="@+id/pauseButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/action_secondary" android:text="Pause" android:textAllCaps="false" android:textColor="#F5F1F8"/>
            <Button android:id="@+id/stopButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/action_secondary" android:text="Stop" android:textAllCaps="false" android:textColor="#F5F1F8"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>