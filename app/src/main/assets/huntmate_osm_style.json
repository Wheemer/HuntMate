{
  "version": 8,
  "name": "HuntMate OpenStreetMap",
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#e8e5df"}},
    {"id": "osm", "type": "raster", "source": "osm", "minzoom": 0, "maxzoom": 19, "paint": {"raster-fade-duration": 0}}
  ]
}
